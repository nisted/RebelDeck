[Unit]
Description=RebelDeck (Companion button decks for phones and tablets)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Environment=REBELDECK_HEADLESS=1
ExecStart=/usr/bin/python3 /opt/rebeldeck/run.py --headless
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
